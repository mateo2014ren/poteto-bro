/* ============ 飞行状态 ============ */
const cvF=$('#cvF'),buildView=$('#build'),flightView=$('#flight');
let fctx=null,fRAF=0,viewW=0,viewH=0,rocketAngle=0,parachuteEquipped=false,parachuteOpen=false,parachuteTimer=0,impactFailed=false;
const SPEEDS=[1,5,10,20];let spdI=1;
const G={phase:'preLaunch',worldY:0,v:0,fuel:0,maxFuel:0,mass:0,engines:0,thrust:0,coastT:0,maxH:0,hasLeft:false,lastT:0};
function physParams(){let mass=0,engines=0,hasParachute=false;for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){const p=grid[r][c];if(!p)continue;if(p.defId==='engine'){mass+=1;engines++;}else if(p.defId==='parachute'){mass+=0.5;}else{mass+=1;}if(p.defId==='parachute')hasParachute=true;}G.mass=mass;G.engines=engines;parachuteEquipped=hasParachute;let tanks=0;for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++)if(grid[r][c]&&grid[r][c].defId==='tank')tanks++;G.maxFuel=tanks*60;}

/* ============ 发射 ============ */
$('#btnLaunch').addEventListener('click',()=>{
  if(!bakeRocket())return;
  physParams();lockedTrajectory=null;trajectoryFlightT=0;G.fuel=G.maxFuel;G.worldY=0;G.v=0;G.coastT=0;G.maxH=0;G.hasLeft=false;G.phase='preLaunch';spdI=1;rocketAngle=0;setSpeedBtn();
  buildView.style.display='none';flightView.style.display='block';$('#btnClearMode').style.display='none';$('#btnClear').style.display='none';$('#btnMap').style.display='inline-block';
  $('#btnLaunch').style.display='none';$('#btnClear').style.display='none';$('#btnSpeed').style.display='inline-block';$('#btnBack').style.display='inline-block';
  cancelAnimationFrame(fRAF);fRAF=requestAnimationFrame(initFlight);
});
function initFlight(){sizeFlightCanvas();bindFlightEvents();G.lastT=performance.now();drawFlight();}
function sizeFlightCanvas(){const w=cvF.clientWidth,h=cvF.clientHeight;if(w===0||h===0){fRAF=requestAnimationFrame(sizeFlightCanvas);return;}const dpr=window.devicePixelRatio||1;cvF.width=Math.round(w*dpr);cvF.height=Math.round(h*dpr);fctx=cvF.getContext('2d');fctx.setTransform(dpr,0,0,dpr,0,0);viewW=w;viewH=h;regenerateFlightStars(w,h);}
let attitudeTimer=null;
function bindFlightEvents(){
  const ig=$('#bigLaunch');ig.replaceWith(ig.cloneNode(true));$('#bigLaunch').addEventListener('click',onIgnite);
  $('#btnSpeed').replaceWith($('#btnSpeed').cloneNode(true));$('#btnSpeed').addEventListener('click',()=>{spdI=(spdI+1)%SPEEDS.length;setSpeedBtn();});
  $('#btnBack').replaceWith($('#btnBack').cloneNode(true));$('#btnBack').addEventListener('click',backToBuild);
  $('#btnAgain').replaceWith($('#btnAgain').cloneNode(true));$('#btnAgain').addEventListener('click',againFlight);
  $('#btnRet').replaceWith($('#btnRet').cloneNode(true));$('#btnRet').addEventListener('click',backToBuild);

  const startRotate=dir=>{
    clearInterval(attitudeTimer);
    attitudeTimer=setInterval(()=>{
      if(G.phase==='flight'||G.phase==='fall') rocketAngle+=dir*1.5;
    },30);
  };
  const stopRotate=()=>{clearInterval(attitudeTimer);attitudeTimer=null;};
  const left=$('#btnLeft'),right=$('#btnRight');
  [['mousedown',left,-1],['mousedown',right,1],['touchstart',left,-1],['touchstart',right,1]].forEach(([ev,el,dir])=>{
    el.addEventListener(ev,e=>{e.preventDefault();startRotate(dir);},{passive:false});
  });
  ['mouseup','mouseleave','touchend','touchcancel'].forEach(ev=>{
    left.addEventListener(ev,stopRotate);right.addEventListener(ev,stopRotate);
  });
  window.onkeydown=e=>{
    if(e.key==='ArrowLeft'||e.key==='ArrowRight'){
      if(G.phase==='flight'||G.phase==='fall'){
        rocketAngle+=(e.key==='ArrowLeft'?-1:1)*2.5;
        e.preventDefault();
      }
    }
  };
}
function setSpeedBtn(){$('#btnSpeed').textContent='速度 '+SPEEDS[spdI]+'x';}
function updateParachute(dt){
  if(!parachuteEquipped || G.phase!=='fall')return;

  // 到5000m自动打开。
  if(!parachuteOpen && G.worldY<=5000 && G.v<0 && parachuteIsCorrectlyMounted()){
    parachuteOpen=true;
    parachuteTimer=0;
  }

  if(parachuteOpen && parachuteIsCorrectlyMounted()){
    parachuteTimer+=dt;
    // 5000m 开伞后，平滑地把下降速度压到 5m/s。
    const downSpeed=Math.max(5,Math.abs(G.v)-6*dt);
    G.v=-downSpeed;
  }
}

function onIgnite(){if(G.phase!=='preLaunch')return;parachuteOpen=false;parachuteTimer=0;impactFailed=false;G.phase='flight';$('#bigLaunch').style.display='none';$('#attitudeControls').style.display='flex';G.lastT=performance.now();initEmitters();requestAnimationFrame(loop);}
function backToBuild(){lockedTrajectory=null;rocketAngle=0;G.phase='build';closeMap();$('#btnClearMode').style.display='inline-block';$('#btnMap').style.display='none';$('#btnClear').style.display='inline-block';cancelAnimationFrame(fRAF);flightView.style.display='none';buildView.style.display='flex';$('#btnLaunch').style.display='inline-block';$('#btnClear').style.display='inline-block';$('#btnSpeed').style.display='none';$('#btnBack').style.display='none';$('#bigLaunch').style.display='none';$('#attitudeControls').style.display='none';$('#resultPop').style.display='none';particles=[];emitters=[];updateTopStat();}
function againFlight(){lockedTrajectory=null;trajectoryFlightT=0;spdI=1;rocketAngle=0;parachuteOpen=false;parachuteTimer=0;impactFailed=false;G.worldY=0;G.v=0;G.fuel=G.maxFuel;G.coastT=0;G.maxH=0;G.hasLeft=false;G.phase='preLaunch';$('#resultPop').style.display='none';G.lastT=performance.now();drawFlight();}

/* ============ 多发动机 Emitter 池 ============
   发射瞬间由 engineList(烘焙前抽取的每台发动机 col/row/localX/localY)建池。
   每台 Emitter 持有相对箭体(贴图内)的偏移 (relX,relY_bottom)，飞行中由其 world→screen 投影独立出火。
*/
let emitters=[],particles=[];
function initEmitters(){emitters=[];for(const e of engineList){emitters.push({relX:e.localX-rocketM.w/2,relY:rocketM.h-(rocketM.h-e.localY),active:true});}}

/* ============ 主循环 ============ */
function loop(now){if(G.phase==='build')return;let dt=(now-G.lastT)/1000;G.lastT=now;if(dt<0)dt=0;if(dt>0.05)dt=0.05;const sdt=dt*SPEEDS[spdI];const NET=4.9;
  if(G.phase==='flight'){
    if(G.fuel>0&&G.engines>0){
      G.v+=NET*sdt;
      G.fuel-=sdt;
      if(G.fuel<0)G.fuel=0;
    }else{
      G.coastT+=sdt;
      // 发动机停止后继续上升，直到达到最高点
      // 在速度降到 0 时才真正进入下落阶段。
      G.v-=1*sdt;
      if(G.v<=0){
        G.v=0;
        lockedTrajectory=makeReferenceTrajectory().map(p=>({x:p.x,y:p.y,t:p.t}));
        G.phase='fall';
      }
    }
  }else if(G.phase==='fall'){
    // 下落阶段持续加速，开伞前不设置速度上限。
    G.v-=4.0*sdt;
  }
  G.worldY+=G.v*sdt;
  if(G.phase==='flight' || G.phase==='fall') trajectoryFlightT+=sdt;
  if(G.worldY>0.5)G.hasLeft=true;
  if(G.worldY<0){if(G.hasLeft&&G.v<=0){G.worldY=0;G.v=0;handleGroundImpact();}else{G.worldY=0;if(G.v<0)G.v=0;}}
  G.maxH=Math.max(G.maxH,G.worldY);drawFlight();if(G.phase!=='landed')fRAF=requestAnimationFrame(loop);
}
function handleGroundImpact(){
  if(Math.abs(G.v)>200){
    impactFailed=true;
    onFail();
    return;
  }
  onLand();
}

function onLand(){G.phase='landed';$('#attitudeControls').style.display='none';$('#btnMap').style.display='inline-block';$('#resM').textContent=(G.maxH).toFixed(0)+' m';$('#resultPop').style.display='block';}

/* ============ 相机：火箭锁定 + 地面按世界坐标下移 ============
   发射台固定在世界高度 wy=0。
   火箭在低空时从发射台起飞，升高后相机逐渐跟随火箭；
   地面不会再“跟着火箭走”，而是按照真实世界高度投影到屏幕，
   高度足够后会滑到屏幕底部并停止渲染。
*/
const GROUND_THICK=5000;

// 火箭底部：起飞时贴近发射台，升高后逐渐进入屏幕中部。
function rocketBottomScreenY(wy){
  // 火箭整体往屏幕上方移动一些，给下面的草地和发射架留出空间
  const launchY=viewH*0.58;
  const followY=viewH*0.44+rocketM.h/2;
  const k=Math.min(1,wy/600);
  return lerp(launchY,followY,k);
}

function rocketRect(wy){
  const bot=rocketBottomScreenY(wy);
  return {cx:viewW/2,cy:bot-rocketM.h,w:rocketM.w,h:rocketM.h,bot:bot};
}

// 世界地面 wy=0 在相机中的屏幕位置。
// 低空时基本固定；超过约 600 m 后，相机开始跟随火箭，
// 地面会快速向下移出画面。
function groundTopY(wy){
  const launchY=viewH*0.62;

  // 0~600m：相机逐渐跟随，地面向下移动；
  // >600m：保持更强的跟随效果，让地面很快离开画面。
  const cameraFollow=Math.min(1,Math.max(0,wy/600));
  const lowAltShift=wy*0.45;
  const highAltExtra=Math.max(0,wy-600)*0.95;

  return launchY + lowAltShift + highAltExtra*cameraFollow;
}

function atmosphereColor(alt){
  // 0m 浅蓝，50km 深蓝，100km 黑色。
  const a=Math.max(0,alt);
  const c0=[150,220,255], c1=[8,35,110], c2=[0,0,0];
  let c;
  if(a<=50000){
    const t=a/50000;
    c=c0.map((v,i)=>Math.round(v+(c1[i]-v)*t));
  }else if(a<100000){
    const t=(a-50000)/50000;
    c=c1.map((v,i)=>Math.round(v+(c2[i]-v)*t));
  }else c=c2;
  return `rgb(${c[0]},${c[1]},${c[2]})`;
}

function drawAtmosphere(ctx,W,H,alt){
  ctx.fillStyle=atmosphereColor(Math.max(0,alt));
  ctx.fillRect(0,0,W,H);

  // 50km以上保持黑色并显示星星；高空星星逐渐明显。
  if(alt>25000){
    const alpha=Math.min(1,(alt-25000)/25000);
    ctx.fillStyle='#fff';
    ctx.globalAlpha=.25+.65*alpha;
    for(let i=0;i<170;i++){
      const x=(i*97+13)%W,y=(i*53+37)%H;
      const s=1+(i%3)*.4;
      ctx.fillRect(x,y,s,s);
    }
    ctx.globalAlpha=1;
  }
}

function drawFlight(){if(viewW<=0||viewH<=0){if(cvF.clientWidth>0)sizeFlightCanvas();else return;}
  const ctx=fctx,W=viewW,H=viewH,wy=G.worldY;
  drawAtmosphere(ctx,W,H,wy);
  const rr=rocketRect(wy);const gtop=groundTopY(wy);

  // 1) 天空：铺满整画布，按高度渐变 + >4km 星空
  drawSky(ctx,W,H,wy/1000);

  // 2) 地面+发射台：只在屏幕与世界地面片段相交时绘制。
  const gbot=gtop+GROUND_THICK;
  if(gbot>0){
    const y0=Math.max(0,gtop);
    const y1=Math.min(H,gbot);
    if(y1>y0){
      ctx.fillStyle='#3f7a3f';
      ctx.fillRect(0,y0,W,y1-y0);
      if(gtop>=0 && gtop<H){
        ctx.fillStyle='#2f5e2f';
        ctx.fillRect(0,gtop,W,4);
      }
    }

    // 发射台：保留单独的发射台，不再显示左右架子。
    // 宽度随火箭宽度自动调整，并在起飞后随地面一起离开画面。
    if(rocketTex && rocketM){
      const padW=Math.max(120,rocketM.w+36);
      const padH=28;
      const baseW=padW+32;
      const px=W/2-padW/2;
      const py=gtop-padH;

      if(py < H+40 && gtop > -60){
        ctx.fillStyle='#666';
        ctx.fillRect(px,py,padW,padH);

        ctx.fillStyle='#4b4b4b';
        ctx.fillRect(W/2-baseW/2,gtop-10,baseW,10);

        ctx.fillStyle='#777';
        ctx.fillRect(px-8,py+4,8,padH-4);
        ctx.fillRect(px+padW,py+4,8,padH-4);
      }
    }
  }

  // 降落伞：打开后显示在火箭上方。
  if(parachuteOpen){
    ctx.save();

    // 巨大降落伞：橙白交替半圆，伞绳连接到指令舱顶部。
    const pw=Math.max(80,rocketM.w*2.8);
    const ph=Math.max(45,pw*.48);
    const left=rr.cx-pw/2;
    const right=rr.cx+pw/2;
    const base=rr.cy-rocketM.h*.02;
    const top=base-ph;

    ctx.save();
    ctx.beginPath();
    ctx.moveTo(left,base);
    ctx.quadraticCurveTo(rr.cx,top,right,base);
    ctx.closePath();
    ctx.clip();

    // 橙白交替扇区
    const segs=8;
    for(let i=0;i<segs;i++){
      const x0=left+(pw*i/segs);
      const x1=left+(pw*(i+1)/segs);
      ctx.fillStyle=(i%2===0)?'#ff7a00':'#fff';
      ctx.beginPath();
      ctx.moveTo(x0,base);
      ctx.lineTo(x1,base);
      ctx.quadraticCurveTo(
        left+pw*(i+.5)/segs,
        top,
        x0,
        base
      );
      ctx.closePath();
      ctx.fill();
    }
    ctx.restore();

    ctx.strokeStyle='#111';
    ctx.lineWidth=2.5;
    ctx.beginPath();
    ctx.moveTo(left,base);
    ctx.quadraticCurveTo(rr.cx,top,right,base);
    ctx.stroke();

    // 黑色伞绳，左右两侧连接到指令舱。
    const attachY=rr.cy-rocketM.h*.02;
    ctx.beginPath();
    ctx.moveTo(left+pw*.12,base);
    ctx.lineTo(rr.cx-rocketM.w*.32,attachY);
    ctx.moveTo(right-pw*.12,base);
    ctx.lineTo(rr.cx+rocketM.w*.32,attachY);
    ctx.moveTo(rr.cx,base);
    ctx.lineTo(rr.cx,attachY);
    ctx.stroke();

    ctx.restore();
  }

  // 3) 整箭贴图(一次绘制) + 姿态旋转
  if(rocketTex&&rocketM){
    ctx.save();
    const cx=rr.cx, cy=rr.cy+rocketM.h/2;
    ctx.translate(cx,cy);
    ctx.rotate(rocketAngle*Math.PI/180);
    ctx.drawImage(rocketTex,-rr.w/2,-rr.h/2,rr.w,rr.h);
    ctx.restore();
  }

  // 4) 多发动机尾焰。尾焰随火箭姿态一起旋转。
  if(G.phase==='flight'&&G.fuel>0){
    for(const em of emitters){
      em.active=true;
      const ex0=rr.cx+em.relX, ey0=rr.bot+em.relY-rocketM.h;
      const rad=rocketAngle*Math.PI/180;
      const cx=rr.cx, cy=rr.cy+rocketM.h/2;
      const dx=ex0-cx,dy=ey0-cy;
      const ex=cx+dx*Math.cos(rad)-dy*Math.sin(rad);
      const ey=cy+dx*Math.sin(rad)+dy*Math.cos(rad);
      spawnFromEmitter(ex,ey,em);
    }
    drawEngineFlame(ctx,rr);
  }
  else{for(const em of emitters)em.active=false;}
  const pdt=Math.min(0.05,(performance.now()-G.lastT)/1000)||0.016;
  updateParticles(pdt);drawParticles(ctx);

  // HUD
  $('#hAlt').textContent='高度 '+Math.max(0,wy).toFixed(0)+' m';
  $('#hSpd').textContent='速度 '+G.v.toFixed(1)+' m/s';
  $('#hFuel').textContent=G.maxFuel>0?('燃料 '+(G.fuel).toFixed(0)+'s'):'燃料 --';
  $('#hMax').textContent='最高 '+G.maxH.toFixed(0)+' m';
  $('#hMass').textContent='重量 '+G.mass+' t';
  $('#hThr').textContent='推力 '+(G.engines*5)+' t';
  let st='就绪';if(G.phase==='flight')st=G.fuel>0?'上升中':'滑行中';else if(G.phase==='fall')st='下落中';else if(G.phase==='landed')st='已着陆';$('#hSt').textContent=st;
  $('#bigLaunch').style.display=(G.phase==='preLaunch')?'block':'none';
}

let flightStars=[];
function regenerateFlightStars(W,H){
  flightStars=[];
  const n=180;
  for(let i=0;i<n;i++){
    flightStars.push({
      x:Math.random()*W,
      y:Math.random()*H,
      s:0.7+Math.random()*2.0,
      a:0.35+Math.random()*0.65
    });
  }
}
function drawSky(ctx,W,H,altKm){
  const altM=Math.max(0,altKm*1000);
  ctx.fillStyle=atmosphereColor(altM);
  ctx.fillRect(0,0,W,H);

  // 随机星空：高空逐渐出现，100km以上完全显示。
  if(altM>30000){
    if(!flightStars.length)regenerateFlightStars(W,H);
    const alpha=Math.min(1,(altM-30000)/70000);
    ctx.save();
    ctx.globalAlpha=alpha;
    ctx.fillStyle='#fff';
    for(const st of flightStars){
      ctx.globalAlpha=alpha*st.a;
      ctx.fillRect(st.x,st.y,st.s,st.s);
    }
    ctx.restore();
  }
}

/* ============ 粒子系统（多 Emitter） ============ */
function spawnFromEmitter(ex,ey,em){if(Math.random()<0.7)particles.push({x:ex+(Math.random()*14-7),y:ey,vx:(Math.random()*2-1),vy:60+Math.random()*90,life:0.3+Math.random()*0.25,r:5+Math.random()*7,color:'rgba(255,'+Math.floor(140+Math.random()*60)+','+Math.floor(30+Math.random()*30)+','});}
function updateParticles(dt){for(const p of particles){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy*=0.96;p.life-=dt;}for(let i=particles.length-1;i>=0;i--)if(particles[i].life<=0)particles.splice(i,1);}
function drawParticles(ctx){for(const p of particles){ctx.beginPath();ctx.fillStyle='rgba(255,160,40,'+Math.max(0,p.life*2).toFixed(2)+')';ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();}}
function drawEngineFlame(ctx,rr){
  for(const em of emitters){
    const ex0=rr.cx+em.relX,ey0=rr.bot+em.relY-rocketM.h;
    const rad=rocketAngle*Math.PI/180;
    const cx=rr.cx,cy=rr.cy+rocketM.h/2;
    const dx=ex0-cx,dy=ey0-cy;
    const ex=cx+dx*Math.cos(rad)-dy*Math.sin(rad);
    const ey=cy+dx*Math.sin(rad)+dy*Math.cos(rad);

    ctx.save();
    ctx.translate(ex,ey);
    ctx.rotate(rad);
    const fg=ctx.createRadialGradient(0,0,2,0,26,30);
    fg.addColorStop(0,'#fff5c0');
    fg.addColorStop(0.5,'#ffb347');
    fg.addColorStop(1,'rgba(255,80,0,0)');
    ctx.fillStyle=fg;
    ctx.beginPath();
    ctx.moveTo(-13,0);ctx.lineTo(13,0);ctx.lineTo(0,42);ctx.closePath();ctx.fill();
    ctx.restore();
  }
}

/* ============ 启动 ============ */
buildGridDOM();refreshAllCells();updateTopStat();
window.addEventListener('resize',()=>{if(G.phase!=='build'){sizeFlightCanvas();drawFlight();}});
