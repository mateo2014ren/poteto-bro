<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SFS</title>
<style>
  :root{--bg:#eef1f4;--panel:#fff;--line:#d8dce0;--ink:#3c4043;--brand:#1a73e8;--brand-h:#1765cc;--ghost:#f1f3f5;--ghost-h:#e4e8ec;}
  *{box-sizing:border-box;}html,body{margin:0;padding:0;height:100%;}
  body{font-family:-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--ink);overflow:hidden;}
  #topbar{height:52px;background:var(--panel);border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 16px;gap:12px;}
  #topbar .t{font-weight:800;font-size:20px;letter-spacing:.5px;}#topbar .sp{flex:1;}
  .btn{height:34px;padding:0 16px;border-radius:8px;border:1px solid var(--line);background:var(--ghost);color:var(--ink);font-size:14px;font-weight:600;cursor:pointer;transition:.15s;white-space:nowrap;}
  .btn:hover{background:var(--ghost-h);}.btn.primary{background:var(--brand);color:#fff;border-color:var(--brand);}.btn.primary:hover{background:var(--brand-h);border-color:var(--brand-h);}
  .map-dir-btn{
    width:64px;height:52px;border:1px solid rgba(255,255,255,.35);
    border-radius:16px;background:rgba(255,255,255,.14);color:#fff;
    backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    box-shadow:0 6px 20px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.22);
    font-size:22px;font-weight:800;cursor:pointer;transition:transform .12s,background .12s;
  }
  .map-dir-btn:hover{background:rgba(255,255,255,.23);transform:translateY(-2px);}
  .map-dir-btn:active{transform:scale(.94);}
  .flight-dir-btn{
    width:62px;height:46px;border:1px solid rgba(255,255,255,.22);
    border-radius:14px;background:linear-gradient(180deg,rgba(55,62,74,.92),rgba(25,30,39,.92));
    color:#fff;box-shadow:0 4px 12px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.18);
    font-size:17px;font-weight:800;cursor:pointer;transition:transform .12s,filter .12s;
  }
  .flight-dir-btn:hover{filter:brightness(1.14);}
  .flight-dir-btn:active{transform:scale(.93);}
  .flight-dir-btn span{display:block;transform:translateY(-1px);}
  .flight-zoom-btn{
    min-width:38px;height:34px;border:1px solid rgba(255,255,255,.20);
    border-radius:9px;background:rgba(30,35,44,.82);color:#fff;
    font-size:13px;font-weight:700;cursor:pointer;
    box-shadow:0 3px 10px rgba(0,0,0,.25);
  }
  .flight-zoom-btn:active{transform:scale(.94);}
  .rocket-zoom-value{min-width:40px;text-align:center;font-size:12px;font-weight:700;line-height:34px;}
  #wrap{flex:1;display:flex;height:calc(100% - 52px);}
  #build{flex:1;display:flex;height:100%;}
  #parts{width:116px;background:var(--panel);border-right:1px solid var(--line);padding:12px 8px;display:flex;flex-direction:column;gap:10px;align-items:center;}
  #parts .lab{font-size:11px;color:#888;margin-bottom:2px;}
  .part-card{width:92px;height:92px;background:var(--ghost);border:2px solid transparent;border-radius:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.15s;position:relative;}
  .part-card:hover{background:var(--ghost-h);}.part-card.sel{border-color:var(--brand);background:#e8f0fe;}
  .part-card canvas{width:72px;height:72px;}
  #grid-host{flex:1;display:flex;align-items:center;justify-content:center;padding:16px;}
  #grid{position:relative;background:#fafbfc;border:2px solid #333;border-radius:6px;display:grid;grid-template-columns:repeat(5,84px);grid-template-rows:repeat(7,84px);}
  #grid .cell{border-right:1px solid #cfd4d8;border-bottom:1px solid #cfd4d8;position:relative;}
  #grid .cell:nth-child(5n){border-right:none;}#grid .cell:nth-child(n+31){border-bottom:none;}
  .cell-cv{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}
  #flight{position:fixed;inset:52px 0 0 0;display:none;background:#000;}
  #cvF{position:absolute;inset:0;width:100%;height:100%;}
  #hud{position:absolute;top:14px;left:16px;color:#fff;font:700 22px/1.5 -apple-system,"Segoe UI",sans-serif;text-shadow:0 1px 3px rgba(0,0,0,.5);pointer-events:none;}
  #hud .row{display:flex;gap:16px;flex-wrap:wrap;}#hud .v{color:#cfe6f5;}#hud .t{color:#ffd58a;}
  #bigLaunch{position:absolute;left:50%;bottom:34px;transform:translateX(-50%);width:60%;max-width:520px;height:84px;border-radius:42px;border:none;background:linear-gradient(180deg,#ff7043,#e64a19);color:#fff;font-size:30px;font-weight:800;letter-spacing:2px;cursor:pointer;box-shadow:0 8px 24px rgba(230,74,25,.45);display:none;}
  #bigLaunch:hover{filter:brightness(1.06);}
  #resultPop{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);background:rgba(20,20,28,.92);color:#fff;padding:26px 34px;border-radius:18px;text-align:center;display:none;min-width:300px;box-shadow:0 12px 40px rgba(0,0,0,.5);}
  #resultPop .h{font-size:15px;color:#9aa0a6;margin-bottom:8px;}#resultPop .m{font-size:34px;font-weight:800;margin-bottom:18px;}
  #resultPop .btns{display:flex;gap:12px;justify-content:center;}
</style>
</head>
<body>
<div id="topbar">
  <div class="t">SFS</div>
  <div id="topStat" style="font-size:14px;color:#5f6368;"></div>
  <div class="sp"></div>
  <button class="btn" id="btnClearMode">清除</button>
  <button class="btn" id="btnClear">清空</button>
  <button class="btn primary" id="btnLaunch">发射</button>
  
  <button class="btn" id="btnMap" style="display:none;">地图</button>
  <button class="btn" id="btnSpeed" style="display:none;">速度 5x</button>
  <button class="btn" id="btnBack" style="display:none;">返回组装</button>
</div>
<div id="wrap"><div id="build">
  <div id="parts"><div class="lab">零件</div>
    <div class="part-card" data-id="command"><canvas width="144" height="144"></canvas></div>
    <div class="part-card" data-id="tank"><canvas width="144" height="144"></canvas></div>
    <div class="part-card" data-id="engine"><canvas width="144" height="144"></canvas></div>
    <div class="part-card" data-id="parachute"><canvas width="144" height="144"></canvas></div>
  </div>
  <div id="grid-host">
    <div id="grid"></div>
  </div>
</div></div>
<div id="mapView" style="position:fixed;inset:52px 0 0 0;display:none;background:#080b12;z-index:20;">
  <canvas id="cvMap" style="position:absolute;inset:0;width:100%;height:100%;"></canvas>
  <div style="position:absolute;top:14px;left:16px;color:#fff;font:700 22px/1.5 -apple-system,'Segoe UI',sans-serif;text-shadow:0 1px 3px #000;">地图</div>
  <div id="mapAttitudeControls" style="position:absolute;left:50%;bottom:72px;transform:translateX(-50%);display:flex;gap:14px;z-index:3;">
    <button class="map-dir-btn" id="mapLeft" aria-label="向左调整">◀</button>
    <button class="map-dir-btn" id="mapRight" aria-label="向右调整">▶</button>
  </div>
</div>
<div id="flight">
  <canvas id="cvF"></canvas>
  <div id="hud">
    <div class="row"><span id="hAlt">高度 0 m</span><span id="hSpd">速度 0 m/s</span></div>
    <div class="row"><span id="hFuel">燃料 --</span><span id="hMax">最高 0 m</span></div>
    <div class="row"><span class="v" id="hMass">重量 0 t</span><span class="t" id="hThr">推力 0 t</span></div>
    <div id="hSt" style="font-size:16px;color:#ffd58a;margin-top:4px;">就绪</div>
  </div>
  <button id="bigLaunch">发 射</button>
  <div id="flightZoomControls" style="position:absolute;right:14px;top:14px;z-index:6;display:flex;gap:7px;padding:5px;border-radius:14px;background:rgba(10,14,20,.55);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);">
  <button class="flight-zoom-btn" id="flightZoomOut">−</button>
  <button class="flight-zoom-btn" id="flightZoomReset">100%</button>
  <button class="flight-zoom-btn" id="flightZoomIn">＋</button>
</div>
<div id="attitudeControls" style="display:none;position:absolute;left:50%;bottom:26px;transform:translateX(-50%);gap:10px;z-index:5;padding:6px;border-radius:18px;background:rgba(10,14,20,.55);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 8px 28px rgba(0,0,0,.28);">
    <button class="flight-dir-btn" id="btnLeft" aria-label="向左"><span>◀</span></button>
    <button class="flight-dir-btn" id="btnRight" aria-label="向右"><span>▶</span></button>
  </div>
  <div id="resultPop"><div class="h">飞行结束 · 最大高度</div><div class="m" id="resM">0 m</div>
    <div class="btns"><button class="btn primary" id="btnAgain">再飞一次</button><button class="btn" id="btnRet">返回组装</button></div>
  </div>
</div>
<script>
"use strict";
const $=s=>document.querySelector(s),CE=t=>document.createElement(t);
const lerp=(a,b,t)=>a+(b-a)*t;
function lerpColor(a,b,t){
  const hasCommandModule = grid.flat().some(p => p && (p.defId==='command' || p.defId==='capsule' || p.defId==='cmd'));
  if(!hasCommandModule){alert('无法发射：火箭必须安装指令舱。');return;}
const pa=parseInt(a.slice(1),16),pb=parseInt(b.slice(1),16);const ar=(pa>>16)&255,ag=(pa>>8)&255,ab=pa&255;const br=(pb>>16)&255,bg=(pb>>8)&255,bb=pb&255;return 'rgb('+Math.round(lerp(ar,br,t))+','+Math.round(lerp(ag,bg,t))+','+Math.round(lerp(ab,bb,t))+')';}
function makeOff(w,h){const c=CE('canvas');c.width=w;c.height=h;return c;}
function setFillG(ctx,x,y,w,h,c1,c2){const g=ctx.createLinearGradient(x,y,x+w,y);g.addColorStop(0,c1);g.addColorStop(1,c2);ctx.fillStyle=g;}

/* ============ 零件外观（冻结：纹理保持不变） ============ */
const PW=64,PH=64,BW=Math.round(PW*0.86);
const PART_DEFS={command:{draw:drawCommand},tank:{draw:drawTank},engine:{draw:drawEngine},parachute:{draw:drawParachute}};
function drawCommand(ctx,cx,cyTop){
  ctx.save();ctx.lineJoin='round';ctx.lineWidth=3;
  ctx.beginPath();ctx.moveTo(cx,cyTop+7);ctx.lineTo(cx+BW/2-2,cyTop+PH-7);ctx.lineTo(cx-BW/2+2,cyTop+PH-7);ctx.closePath();
  setFillG(ctx,cx-BW/2,cyTop,BW,PH,'#9aa0a6','#5f6368');ctx.fill();ctx.strokeStyle='#3c4043';ctx.stroke();
  ctx.fillStyle='#dadce0';if(ctx.roundRect)ctx.roundRect(cx-10,cyTop+1,20,7,3);else ctx.rect(cx-10,cyTop+1,20,7);ctx.fill();
  ctx.fillStyle='#8ab4f0';ctx.beginPath();ctx.arc(cx-12,cyTop+PH*0.62,4.5,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(cx+12,cyTop+PH*0.62,4.5,0,Math.PI*2);ctx.fill();
  ctx.restore();
}
function drawTank(ctx,cx,cyTop){
  ctx.save();ctx.lineWidth=2;
  ctx.beginPath();ctx.rect(cx-BW/2,cyTop+2,BW,PH-4);
  setFillG(ctx,cx-BW/2,cyTop,BW,PH,'#cfd1d3','#8a8d91');ctx.fill();ctx.strokeStyle='#6b6f73';ctx.stroke();
  ctx.strokeStyle='#7a7d81';ctx.lineWidth=2;
  for(let i=1;i<=3;i++){const sy=cyTop+(PH*i)/4;ctx.beginPath();ctx.moveTo(cx-BW/2+9,sy);ctx.lineTo(cx+BW/2-9,sy);ctx.stroke();}
  ctx.restore();
}
function drawEngine(ctx,cx,cyTop){
  ctx.save();ctx.lineJoin='round';ctx.lineWidth=3;
  ctx.beginPath();ctx.moveTo(cx-BW/2+2,cyTop+7);ctx.lineTo(cx+BW/2-2,cyTop+7);ctx.lineTo(cx,cyTop+PH-5);ctx.closePath();
  setFillG(ctx,cx-BW/2,cyTop,BW,PH,'#bfc1c4','#7c7f83');ctx.fill();ctx.strokeStyle='#4a4d51';ctx.stroke();
  ctx.fillStyle='#202124';if(ctx.roundRect)ctx.roundRect(cx-9,cyTop+2,18,7,3);else ctx.rect(cx-9,cyTop+2,18,7);ctx.fill();
  ctx.restore();
}


function parachuteIsCorrectlyMounted(){
  for(let r=0;r<ROWS;r++){
    for(let c=0;c<COLS;c++){
      const p=grid[r][c];
      if(p && p.defId==='parachute'){
        // 网格中“上面”= r-1；只有正上方紧贴指令舱才算有效。
        const below = r+1<ROWS ? grid[r+1][c] : null;
        if(!(below && (below.defId==='command' || below.defId==='capsule' || below.defId==='cmd'))){
          return false;
        }
      }
    }
  }
  return true;
}
function drawParachute(ctx,cx,cyTop){
  ctx.save();

  // 0.5 吨降落伞：小型实心白色半圆 + 白色长方形。
  // 整个零件的底部紧贴网格单元最底边。
  const w=BW*.39;
  const left=cx-w/2;
  const right=cx+w/2;
  const bottom=cyTop+PH;
  const rectH=PH*.11;
  const rectTop=bottom-rectH;
  const base=rectTop;


  ctx.fillStyle='#fff';
  ctx.strokeStyle='#111';
  ctx.lineWidth=2.2;

  // 半圆
  ctx.beginPath();
  ctx.moveTo(left,base);
  ctx.quadraticCurveTo(cx,cyTop-.5,right,base);
  ctx.lineTo(left,base);
  ctx.closePath();
  ctx.fill();
  ctx.stroke();

  // 下部长方形
  ctx.fillStyle='#fff';
  ctx.fillRect(left,rectTop,w,rectH);
  ctx.strokeRect(left,rectTop,w,rectH);

  // 半圆与长方形连接处的黑线
  ctx.strokeStyle='#111';
  ctx.lineWidth=2.4;
  ctx.beginPath();
  ctx.moveTo(left,base);
  ctx.lineTo(right,base);
  ctx.stroke();

  ctx.restore();
}

/* ============ 5x7 网格 ============ */
const COLS=5,ROWS=7,CELL=84;
const grid=[];for(let r=0;r<ROWS;r++){const row=[];for(let c=0;c<COLS;c++)row.push(null);grid.push(row);}
const gridEl=$('#grid');
let buildZoom=1;
let trajectoryFlightT=0;
let flightViewZoom=1;
function applyBuildZoom(){
  gridEl.style.transform=`scale(${buildZoom})`;
  gridEl.style.transformOrigin='center center';
  $('#rocketZoomValue').textContent=Math.round(buildZoom*100)+'%';
}
function buildGridDOM(){gridEl.innerHTML='';for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){const d=CE('div');d.className='cell';d.dataset.r=r;d.dataset.c=c;const cv=CE('canvas');cv.className='cell-cv';cv.width=CELL;cv.height=CELL;d.appendChild(cv);gridEl.appendChild(d);}}
function cellEl(r,c){return gridEl.children[r*COLS+c];}
function redrawCell(r,c){const d=cellEl(r,c);const cv=d.querySelector('.cell-cv');const ctx=cv.getContext('2d');ctx.clearRect(0,0,cv.width,cv.height);const p=grid[r][c];if(!p)return;const sc=CELL/PW;ctx.save();ctx.scale(sc,sc);PART_DEFS[p.defId].draw(ctx,PW/2,0);ctx.restore();}
function refreshAllCells(){for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++)redrawCell(r,c);}

/* ============ 零件库缩略图 + 点击选中 ============ */
function drawPartCard(defId,canvas){const ctx=canvas.getContext('2d');ctx.clearRect(0,0,canvas.width,canvas.height);const sc=canvas.width/PW;ctx.save();ctx.scale(sc,sc);PART_DEFS[defId].draw(ctx,PW/2,2);ctx.restore();}
let selDef=null,clearMode=false;
function setClearMode(on){clearMode=on;$('#btnClearMode').classList.toggle('active',on);$('#topStat').textContent=on?'点要清除的部件':'';
  if(on){document.querySelectorAll('.part-card').forEach(x=>x.classList.remove('sel'));selDef=null;}}
document.querySelectorAll('.part-card').forEach(card=>{drawPartCard(card.dataset.id,card.querySelector('canvas'));card.addEventListener('click',()=>{if(clearMode)return;document.querySelectorAll('.part-card').forEach(x=>x.classList.remove('sel'));card.classList.add('sel');selDef=card.dataset.id;});});
$('#btnClearMode').addEventListener('click',()=>setClearMode(!clearMode));

/* ============ 格子命中测试（用于点击放置/移除） ============ */
function hitTestGrid(e){
  const rect=gridEl.getBoundingClientRect();
  const x=e.clientX-rect.left,y=e.clientY-rect.top;
  if(x<0||y<0||x>=rect.width||y>=rect.height)return null;
  const c=Math.floor(x/CELL),r=Math.floor(y/CELL);
  if(c<0||c>=COLS||r<0||r>=ROWS)return null;
  return {r,c,placed:!!grid[r][c]};
}

/* ============ 点击放置 / 移除 ============ */
function onCellClick(r,c){if(clearMode){if(grid[r][c]){grid[r][c]=null;redrawCell(r,c);updateTopStat();}setClearMode(false);return;}if(selDef){grid[r][c]={defId:selDef};redrawCell(r,c);}else if(grid[r][c]){grid[r][c]=null;redrawCell(r,c);}updateTopStat();}
gridEl.addEventListener('click',e=>{const t=hitTestGrid(e);if(!t)return;onCellClick(t.r,t.c);});
$('#btnClear').addEventListener('click',()=>{for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++)grid[r][c]=null;refreshAllCells();updateTopStat();});

/* ============ 顶栏状态 ============ */
function updateTopStat(){let mass=0,thr=0,has=false;for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){const p=grid[r][c];if(!p)continue;has=true;if(p.defId==='engine'){mass+=1;thr+=5;}else if(p.defId==='parachute'){mass+=0.5;}else{mass+=1;}}$('#topStat').textContent=has?('重量 '+mass+' t  推力 '+thr+' t'):'';$('#btnLaunch').disabled=!has;}

/* ============ 烘焙整箭贴图 + 抽取发动机列表 ============ */
let rocketTex=null,rocketM=null,engineList=[];
function bakeRocket(){
  let minR=ROWS,maxR=-1,minC=COLS,maxC=-1,cnt=0;engineList=[];
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){const p=grid[r][c];if(!p)continue;if(r<minR)minR=r;if(r>maxR)maxR=r;if(c<minC)minC=c;if(c>maxC)maxC=c;cnt++;}
  if(cnt===0){rocketTex=null;rocketM=null;return false;}
  const oc=maxC-minC+1,orR=maxR-minR+1;
  const W=oc*PW,H=orR*PH;
  const off=makeOff(W,H);const octx=off.getContext('2d');
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){const p=grid[r][c];if(!p)continue;const def=PART_DEFS[p.defId];const ri=r-minR,ci=c-minC;def.draw(octx,ci*PW+PW/2,ri*PH);
    if(p.defId==='engine')engineList.push({col:c,row:r,localX:(ci+0.5)*PW,localY:(ri+1)*PH});}
  rocketTex=off;rocketM={w:W,h:H,oc,orR};return true;
}

/* ============ 地图模式 ============ */
const cvMap=$('#cvMap'),mapView=$('#mapView');
let mapCtx=null,mapRAF=0,mapZoom=1,mapDragX=0,mapDragY=0,mapDragging=false,mapLastX=0,mapLastY=0;

function sizeMapCanvas(){
  const w=cvMap.clientWidth,h=cvMap.clientHeight;
  if(!w||!h)return;
  const dpr=window.devicePixelRatio||1;
  cvMap.width=Math.round(w*dpr);cvMap.height=Math.round(h*dpr);
  mapCtx=cvMap.getContext('2d');
  mapCtx.setTransform(dpr,0,0,dpr,0,0);
}

let lockedTrajectory=null;
function makeReferenceTrajectory(){
  const angle=rocketAngle*Math.PI/180;
  const launchSpeed=Math.max(1,Math.abs(G.v));
  const vx=launchSpeed*Math.sin(angle);
  const vy=Math.max(1,launchSpeed*Math.cos(angle));
  const g=1;
  const total=Math.max(4,2*vy/g);
  const pts=[];
  const N=900;
  for(let i=0;i<=N;i++){
    const t=i/N*total;
    const y=Math.max(0,vy*t-0.5*g*t*t);
    pts.push({x:vx*t,y,t});
  }
  return pts;
}
function mapTrajectory(){
  return lockedTrajectory || makeReferenceTrajectory();
}

function drawMap(){
  if(!mapCtx)sizeMapCanvas();
  if(!mapCtx)return;

  const ctx=mapCtx,W=cvMap.clientWidth,H=cvMap.clientHeight;
  ctx.clearRect(0,0,W,H);

  // 星空
  ctx.fillStyle='#05070c';
  ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#fff';
  for(let i=0;i<180;i++){
    const x=(i*97+23)%W;
    const y=(i*53+71)%H;
    const s=1+(i%3)*.35;
    ctx.globalAlpha=.25+((i*19)%70)/100;
    ctx.fillRect(x,y,s,s);
  }
  ctx.globalAlpha=1;

  // 无限绿色平地
  const groundY=H*.78+mapDragY;
  ctx.fillStyle='#2f6b32';
  ctx.fillRect(0,groundY,W,H-groundY);
  ctx.fillStyle='#4b9349';
  ctx.fillRect(0,groundY,W,5);

  // 轨迹：姿态改变后实时改变为对应抛物线
  const pts=mapTrajectory();
  const scale=Math.max(0.000001,Math.min(1000000,0.06*mapZoom));
  const originX=W/2+mapDragX;
  const originY=groundY;

  ctx.save();
  ctx.lineCap='round';
  ctx.lineJoin='round';

  // 轨迹必须始终在屏幕上有可见宽度，不能因为无限缩小而“消失”
  const lineWidth=Math.max(2.2,Math.min(6,2.5*Math.sqrt(Math.max(0.05,mapZoom))));
  ctx.strokeStyle='#fff';
  ctx.lineWidth=lineWidth;
  ctx.beginPath();
  let started=false;
  pts.forEach(p=>{
    const x=originX+p.x*scale;
    const y=originY-p.y*scale;
    if(!Number.isFinite(x)||!Number.isFinite(y))return;
    // 只有在当前可见范围附近才参与路径，避免超大缩放时数值过大影响渲染
    if(Math.abs(x)<W*4 && Math.abs(y)<H*4){
      if(!started){ctx.moveTo(x,y);started=true;}
      else ctx.lineTo(x,y);
    }
  });
  if(started)ctx.stroke();

  // 起点加强，确保离得很远时也能看到轨道起点
  ctx.fillStyle='#fff';
  ctx.beginPath();
  ctx.arc(originX,originY,Math.max(2.5,lineWidth/2),0,Math.PI*2);
  ctx.fill();
  ctx.restore();

  // 飞船当前位置：只绘制一个标记
  const h=Math.max(0,G.worldY);
  let cp=pts[0]||{x:0,y:0};

  if(lockedTrajectory && pts.length){
    // Use physical flight time/progress, not nearest altitude, so the red dot
    // stays on the same branch of the fixed trajectory.
    const maxT=pts[pts.length-1].t||1;
    const targetT=Math.max(0,Math.min(maxT,trajectoryFlightT));
    let lo=0,hi=pts.length-1;
    while(lo<hi){
      const mid=(lo+hi)>>1;
      if((pts[mid].t||0)<targetT)lo=mid+1;else hi=mid;
    }
    cp=pts[lo];
  }else{
    let best=Infinity;
    for(const p of pts){
      const d=Math.abs(p.y-h);
      if(d<best){best=d;cp=p;}
    }
  }

  const rx=originX+cp.x*scale;
  const ry=originY-cp.y*scale;

  if(G.worldY>0 || G.phase==='flight' || G.phase==='fall'){
    ctx.save();
    ctx.fillStyle='#fff';
    ctx.beginPath();ctx.arc(rx,ry,5,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#ff7b32';
    ctx.beginPath();ctx.arc(rx,ry,2.4,0,Math.PI*2);ctx.fill();
    ctx.restore();
  }

  // 最高点：显示轨道最高高度
  let peak=pts[0]||{x:0,y:0};
  for(const p of pts) if(p.y>peak.y) peak=p;
  const peakX=originX+peak.x*scale;
  const peakY=originY-peak.y*scale;
  const peakAlt=Math.max(0,peak.y);

  ctx.fillStyle='#fff';
  ctx.font='700 15px -apple-system,"Segoe UI",sans-serif';
  ctx.fillText('最高点 '+peakAlt.toFixed(0)+' m',peakX+10,peakY-10);

  // 飞船：显示当前飞船高度
  const shipAlt=Math.max(0,G.worldY);
  ctx.fillText('飞船 '+shipAlt.toFixed(0)+' m',rx+10,ry-10);

  mapRAF=requestAnimationFrame(drawMap);
}

